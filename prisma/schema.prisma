generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  firstName             String
  lastName              String
  phone                 String?
  passwordHash          String
  emailVerified         Boolean                @default(false)
  image                 String?
  role                  UserRole               @default(CUSTOMER)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  adminActions          AdminAction[]
  alertSubscriptions    AlertSubscription?
  consultantProfile     ConsultantProfile?
  consultations         Consultation[]
  healthProfile         HealthProfile?
  incubationSubmissions IncubationSubmission[]
  interactionFeedback   InteractionFeedback[]
  orders                Order[]
  otpCodes              OtpCode[]
  producerProfile       ProducerProfile?
  productReviews        ProductReview[]
  savedMedications      SavedMedication[]
  sessions              Session[]

  @@index([email])
  @@index([role])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  code      String     @db.VarChar(6)
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id            String        @id @default(cuid())
  userId        String?
  paystackRef   String?       @unique
  paystackTxId  Int?
  custFirstName String
  custLastName  String
  custEmail     String
  custPhone     String
  custAddress   String
  custCity      String
  custState     String
  subtotal      Int
  shipping      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod @default(CARD)
  paymentStatus PayStatus     @default(PENDING)
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation(fields: [userId], references: [id])
  items         OrderItem[]

  @@index([custEmail])
  @@index([paystackRef])
  @@index([userId])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  productEmoji String @default("?")
  price        Int
  quantity     Int
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model HealthProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  conditions String?  @db.LongText
  allergies  String?  @db.LongText
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedMedication {
  id         String   @id @default(cuid())
  userId     String
  name       String
  dose       String?
  frequency  String?
  createdAt  DateTime @default(now())
  normalised String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consultation {
  id               String                   @id @default(cuid())
  userId           String
  practitionerId   String?
  type             ConsultationType
  status           ConsultationStatus       @default(REQUESTED)
  scheduledAt      DateTime?
  notes            String?                  @db.Text
  meetingUrl       String?
  amount           Int?
  paystackRef      String?                  @unique
  paymentStatus    ConsultPayStatus         @default(PENDING)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  consultantId     String?
  feedback         String?                  @db.Text
  payoutStatus     PayoutStatus             @default(NONE)
  platformFeeRate  Float?
  practitionerName String?
  ratedAt          DateTime?
  rating           Int?
  notifications    ConsultantNotification[]
  consultant       ConsultantProfile?       @relation(fields: [consultantId], references: [id])
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([paystackRef])
  @@index([consultantId])
}

model ConsultantProfile {
  id                String                   @id @default(cuid())
  userId            String                   @unique
  specialization    ConsultationType
  bio               String?                  @db.Text
  licenseNumber     String?
  yearsExperience   Int?
  avatarUrl         String?
  status            ConsultantStatus         @default(ACTIVE)
  mustResetPassword Boolean                  @default(true)
  createdBy         String
  deactivatedAt     DateTime?
  deactivatedBy     String?
  deactivationNote  String?                  @db.Text
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  notifications     ConsultantNotification[]
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations     Consultation[]

  @@index([status])
  @@index([specialization])
}

model ConsultantNotification {
  id             String               @id @default(cuid())
  consultantId   String
  consultationId String?
  type           ConsultantNotifyType
  title          String
  body           String               @db.Text
  isRead         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  consultant     ConsultantProfile    @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  consultation   Consultation?        @relation(fields: [consultationId], references: [id])

  @@index([consultantId])
  @@index([consultantId, isRead])
  @@index([createdAt])
  @@index([consultationId], map: "ConsultantNotification_consultationId_fkey")
}

model AlertSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  herbIds   String?  @db.LongText
  channels  String?  @db.LongText
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SafetyAlert {
  id          String        @id @default(cuid())
  title       String
  body        String        @db.Text
  severity    AlertSeverity
  productName String?
  batchNo     String?
  status      AlertStatus   @default(ACTIVE)
  publishedAt DateTime      @default(now())
  createdBy   String

  @@index([severity])
  @@index([status])
}

model ProducerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  businessEmail      String?
  businessPhone      String?
  rcNumber           String?
  nafdacNumber       String?
  tier               ProducerTier       @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedBy         String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationNote   String?            @db.Text
  submittedAt        DateTime?
  cacCertUrl         String?
  labPartnerUrl      String?
  nafdacCertUrl      String?
  insuranceUrl       String?
  state              String?
  website            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  products           ProducerProduct[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProducerProduct {
  id                String            @id @default(cuid())
  slug              String            @unique
  producerProfileId String
  name              String
  description       String?           @db.Text
  category          String?
  status            ProductStatus     @default(DRAFT)
  flaggedAt         DateTime?
  flagReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  batchSubmissions  BatchSubmission[]
  producerProfile   ProducerProfile   @relation(fields: [producerProfileId], references: [id], onDelete: Cascade)
  meta              ProductMeta?

  @@index([producerProfileId])
  @@index([status])
}

model BatchSubmission {
  id           String          @id @default(cuid())
  productId    String
  batchNo      String
  coaFileUrl   String
  labName      String?
  testedAt     DateTime?
  reviewStatus BatchStatus     @default(SUBMITTED)
  reviewedBy   String?
  reviewNotes  String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  supplyChain  String?         @db.LongText
  product      ProducerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([reviewStatus])
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
}

model Herb {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  scientificName String
  localNames     String                @db.LongText
  emoji          String                @default("?")
  category       String
  safetyRating   HerbSafety
  summary        String                @db.Text
  keyBenefits    String                @db.LongText
  warnings       String                @db.LongText
  interactions   String                @db.LongText
  languages      String                @db.LongText
  reviewedAt     DateTime              @default(now())
  publishedAt    DateTime              @default(now())
  isPublished    Boolean               @default(true)
  safetyReviews  ProductSafetyReview[]

  @@index([slug])
  @@index([safetyRating])
  @@index([category])
}

model ProductSafetyReview {
  id             String        @id @default(cuid())
  herbId         String?
  productName    String
  producer       String
  category       String
  emoji          String        @default("?")
  imageUrl       String?
  verdict        ReviewVerdict
  overallScore   Float
  reviewDate     DateTime      @default(now())
  batchNo        String
  labName        String
  nafdacNo       String?
  verifiedBadge  Boolean       @default(false)
  parameters     String        @db.LongText
  summary        String        @db.Text
  recommendation String        @db.Text
  reportUrl      String?
  isPublished    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  herb           Herb?         @relation(fields: [herbId], references: [id])

  @@index([verdict])
  @@index([isPublished])
  @@index([herbId], map: "ProductSafetyReview_herbId_fkey")
}

model SafetyGuide {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String   @db.Text
  category     String
  languages    String   @db.LongText
  readTime     String
  downloadable Boolean  @default(false)
  pdfUrl       String?
  featured     Boolean  @default(false)
  emoji        String   @default("?")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

model PressItem {
  id          String    @id @default(cuid())
  type        PressType
  outlet      String?
  headline    String
  excerpt     String?   @db.Text
  category    String?
  href        String?
  date        DateTime
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([type])
}

model ProductMeta {
  id            String          @id @default(cuid())
  productId     String          @unique
  price         Int             @default(0)
  emoji         String          @default("?")
  imageUrl      String?         @db.MediumText
  productType   String          @default("")
  ingredients   String?         @db.LongText
  warnings      String?         @db.LongText
  nafdacNo      String?
  inStore       Boolean         @default(false)
  stock         Int             @default(0)
  sales         Int             @default(0)
  revenue       Int             @default(0)
  rating        Float           @default(0)
  reviewCount   Int             @default(0)
  featured      Boolean         @default(false)
  unit          String          @default("unit")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  badge         String?
  badgeVariant  String?
  howToUse      String?         @db.Text
  originalPrice Int?
  shortDesc     String?         @db.Text
  tags          String?         @db.LongText
  product       ProducerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model IncubationSubmission {
  id              String               @id @default(cuid())
  userId          String
  productName     String
  formulaCategory String
  description     String               @db.Text
  targetDosage    String?
  currentForm     String?
  originStory     String?              @db.Text
  ndaSigned       Boolean              @default(false)
  ndaSignedAt     DateTime?
  royaltyAgreed   Boolean              @default(false)
  royaltyRate     Float?
  currentPhase    IncubationPhase      @default(INTAKE)
  status          IncubationStatus     @default(ACTIVE)
  adminNotes      String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  documents       IncubationDocument[]
  phases          IncubationPhaseLog[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([currentPhase])
  @@index([status])
}

model IncubationPhaseLog {
  id           String               @id @default(cuid())
  submissionId String
  phase        IncubationPhase
  enteredAt    DateTime             @default(now())
  completedAt  DateTime?
  notes        String?              @db.Text
  completedBy  String?
  submission   IncubationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model IncubationDocument {
  id           String               @id @default(cuid())
  submissionId String
  type         IncubationDocType
  name         String
  url          String
  uploadedAt   DateTime             @default(now())
  uploadedBy   String?
  submission   IncubationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model DrugHerbInteraction {
  id             String                @id @default(cuid())
  drugName       String
  drugAliases    String                @db.LongText
  drugClass      String?
  herbName       String
  herbScientific String?
  herbLocalNames String                @db.LongText
  severity       Severity
  mechanism      String?               @db.Text
  effect         String                @db.Text
  advice         String                @db.Text
  evidenceLevel  EvidenceLevel
  references     String                @db.LongText
  source         String                @default("PHARMACIST_CURATED")
  isPublished    Boolean               @default(true)
  confirmedCount Int                   @default(0)
  disputedCount  Int                   @default(0)
  reportedCount  Int                   @default(0)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  feedback       InteractionFeedback[]

  @@unique([drugName, herbName])
  @@index([drugName])
  @@index([herbName])
  @@index([severity])
  @@index([isPublished])
}

model InteractionQuery {
  id             String   @id @default(cuid())
  userId         String?
  sessionId      String?
  drugs          String   @db.LongText
  herbs          String?  @db.LongText
  resultCount    Int      @default(0)
  hadMissingDrug Boolean  @default(false)
  missingDrugs   String?  @db.LongText
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([hadMissingDrug])
  @@index([createdAt])
}

model InteractionFeedback {
  id            String               @id @default(cuid())
  userId        String
  interactionId String?
  type          String
  drugName      String?
  herbName      String?
  severity      Severity?
  description   String               @db.Text
  outcome       String?              @db.Text
  verified      Boolean              @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?
  promotedToDb  Boolean              @default(false)
  createdAt     DateTime             @default(now())
  interaction   DrugHerbInteraction? @relation(fields: [interactionId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([interactionId])
  @@index([type])
  @@index([verified])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([subscribedAt])
}

model ProductReview {
  id               String              @id @default(cuid())
  productId        String
  userId           String
  rating           Int
  title            String
  body             String              @db.Text
  verifiedPurchase Boolean             @default(false)
  helpfulCount     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulVotes     ReviewHelpfulVote[]

  @@unique([productId, userId])
  @@index([productId])
  @@index([productId, rating])
  @@index([userId], map: "ProductReview_userId_fkey")
}

model ReviewHelpfulVote {
  id        String        @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime      @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

enum UserRole {
  CUSTOMER
  PRODUCER
  ADMIN
  CONSULTANT
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

enum PaymentMethod {
  CARD
  TRANSFER
  COD
}

enum PayStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ConsultationType {
  HERBALIST
  NATUROPATH
  TOXICOLOGIST
  PHARMACIST
}

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ConsultPayStatus {
  PENDING
  PAID
  FAILED
}

enum PayoutStatus {
  NONE
  PENDING
  PAID
}

enum ConsultantStatus {
  ACTIVE
  INACTIVE
}

enum ConsultantNotifyType {
  NEW_BOOKING
  CANCELLED
  RESCHEDULED
  REMINDER
}

enum AlertSeverity {
  INFO
  WARNING
  DANGER
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

enum ProducerTier {
  UNVERIFIED
  VERIFIED
}

enum VerificationStatus {
  UNVERIFIED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  FLAGGED
  BANNED
}

enum BatchStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum HerbSafety {
  SAFE
  CAUTION
  DANGER
  INSUFFICIENT_DATA
}

enum ReviewVerdict {
  APPROVED
  REJECTED
  CAUTION
  PENDING
}

enum PressType {
  COVERAGE
  RELEASE
}

enum IncubationPhase {
  INTAKE
  PRECLINICAL
  BRANDING
  NAFDAC
  LAUNCH
}

enum IncubationStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum IncubationDocType {
  NDA
  ROYALTY_CONTRACT
  FORMULA_SHEET
  LAB_REPORT
  BRAND_GUIDE
  NAFDAC_APPLICATION
  NAFDAC_APPROVAL
  LAUNCH_PLAN
}

enum Severity {
  DANGER
  WARNING
  INFO
  BENEFICIAL
}

enum EvidenceLevel {
  STRONG
  MODERATE
  PRELIMINARY
  ANECDOTAL
}
