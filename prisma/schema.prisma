// Prisma

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// User

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  firstName     String
  lastName      String
  phone         String?
  passwordHash  String
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  otpCodes           OtpCode[]
  orders             Order[]
  sessions           Session[]
  // Customer-specific
  healthProfile      HealthProfile?
  consultations      Consultation[]
  savedMedications   SavedMedication[]
  alertSubscriptions AlertSubscription[]

  // Producer-specific
  producerProfile ProducerProfile?
  // Admin-specific 
  adminActions    AdminAction[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  CUSTOMER
  PRODUCER
  ADMIN
}

// OTP codes
model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  code      String     @db.VarChar(6)
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

// Session (NextAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Orders
model Order {
  id           String  @id @default(cuid())
  userId       String?
  paystackRef  String? @unique
  paystackTxId Int?

  // Customer snapshot (denormalised for guests)
  custFirstName String
  custLastName  String
  custEmail     String
  custPhone     String
  custAddress   String
  custCity      String
  custState     String

  subtotal Int // in kobo
  shipping Int @default(0)
  total    Int

  paymentMethod PaymentMethod @default(CARD)
  paymentStatus PayStatus     @default(PENDING)
  status        OrderStatus   @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([custEmail])
  @@index([paystackRef])
  @@index([userId])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  productEmoji String @default("🌿")
  price        Int // in kobo
  quantity     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum PaymentMethod {
  CARD
  TRANSFER
  COD
}

enum PayStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Customer: Health Profile
model HealthProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  conditions Json? // string[]
  allergies  Json? // string[]
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Customer: Saved Medications (for interaction Engine)
model SavedMedication {
  id        String   @id @default(cuid())
  userId    String
  name      String
  dose      String?
  frequency String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Customer: Telehealth Consultations

model Consultation {
  id             String             @id @default(cuid())
  userId         String
  practitionerId String?
  type           ConsultationType
  status         ConsultationStatus @default(REQUESTED)
  scheduledAt    DateTime?
  notes          String?            @db.Text
  meetingUrl     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum ConsultationType {
  HERBALIST
  NATUROPATH
  TOXICOLOGIST
  PHARMACIST
}

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

// Customer: Safety Alert Subscriptions
model AlertSubscription {
  id        String   @id @default(cuid())
  userId    String
  herbIds   Json? // string[] of herb IDs/names they want alerts for
  channels  Json? // ["email", "sms"]
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

// Safety Alerts (Admin-published)
model SafetyAlert {
  id          String        @id @default(cuid())
  title       String
  body        String        @db.Text
  severity    AlertSeverity
  productName String?
  batchNo     String?
  status      AlertStatus   @default(ACTIVE)
  publishedAt DateTime      @default(now())
  createdBy   String

  @@index([severity])
  @@index([status])
}

enum AlertSeverity {
  INFO
  WARNING
  DANGER
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

// Producer Profile
model ProducerProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  businessName  String
  businessEmail String?
  businessPhone String?
  rcNumber      String? // CAC reqistration
  nafdacNumber  String?
  tier          ProducerTier @default(UNVERIFIED)
  verifiedAt    DateTime?
  verifiedBy    String? // Admin user ID
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ProducerProduct[]
}

enum ProducerTier {
  UNVERIFIED
  VERIFIED
}

// Producer Products
model ProducerProduct {
  id                String        @id @default(cuid())
  producerProfileId String
  name              String
  description       String?       @db.Text
  category          String?
  status            ProductStatus @default(DRAFT)
  flaggedAt         DateTime?
  flagReason        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  producerProfile  ProducerProfile   @relation(fields: [producerProfileId], references: [id], onDelete: Cascade)
  batchSubmissions BatchSubmission[]
  meta             ProductMeta?

  @@index([producerProfileId])
  @@index([status])
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  FLAGGED
  BANNED
}

// Batch / COA Submissions
model BatchSubmission {
  id           String      @id @default(cuid())
  productId    String
  batchNo      String
  coaFileUrl   String // URL to uploaded COA document
  labName      String?
  testedAt     DateTime?
  reviewStatus BatchStatus @default(SUBMITTED)
  reviewedBy   String?
  reviewNotes  String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  product ProducerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([reviewStatus])
}

enum BatchStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Admin Actions (Audit Log)
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String // "Product" | "User" | "Batch" | "Alert"
  targetId   String
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
}

// ── Herb Directory ──────
model Herb {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  scientificName String
  localNames     Json // string[]
  emoji          String     @default("🌿")
  category       String
  safetyRating   HerbSafety
  summary        String     @db.Text
  keyBenefits    Json // string[]
  warnings       Json // string[]
  interactions   Json // string[]
  languages      Json // string[]
  reviewedAt     DateTime   @default(now())
  publishedAt    DateTime   @default(now())
  isPublished    Boolean    @default(true)

  safetyReviews ProductSafetyReview[]

  @@index([slug])
  @@index([safetyRating])
  @@index([category])
}

enum HerbSafety {
  SAFE
  CAUTION
  DANGER
  INSUFFICIENT_DATA
}

// ── Product Safety Reviews ──────
model ProductSafetyReview {
  id             String        @id @default(cuid())
  herbId         String?
  productName    String
  producer       String
  category       String
  emoji          String        @default("🌿")
  verdict        ReviewVerdict
  overallScore   Float
  reviewDate     DateTime      @default(now())
  batchNo        String
  labName        String
  nafdacNo       String?
  verifiedBadge  Boolean       @default(false)
  parameters     Json // { name, result, limit, pass }[]
  summary        String        @db.Text
  recommendation String        @db.Text
  reportUrl      String?
  isPublished    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  herb Herb? @relation(fields: [herbId], references: [id])

  @@index([verdict])
  @@index([isPublished])
}

enum ReviewVerdict {
  APPROVED
  REJECTED
  CAUTION
  PENDING
}

// ── Safety Guides 
model SafetyGuide {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String   @db.Text
  category     String
  languages    Json // string[]
  readTime     String
  downloadable Boolean  @default(false)
  pdfUrl       String?
  featured     Boolean  @default(false)
  emoji        String   @default("📚")
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

// ── Press Coverage & Releases 
model PressItem {
  id          String    @id @default(cuid())
  type        PressType
  outlet      String? // for COVERAGE
  headline    String
  excerpt     String?   @db.Text
  category    String?
  href        String?
  date        DateTime
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([type])
}

enum PressType {
  COVERAGE
  RELEASE
}

model ProductMeta {
  id          String  @id @default(cuid())
  productId   String  @unique
  price       Int     @default(0) // kobo
  emoji       String  @default("🌿")
  productType String  @default("")
  ingredients Json? // string[]
  warnings    Json? // string[]
  nafdacNo    String?
  inStore     Boolean @default(false)
  stock       Int     @default(0)
  sales       Int     @default(0)
  revenue     Int     @default(0) // kobo

  product ProducerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}
